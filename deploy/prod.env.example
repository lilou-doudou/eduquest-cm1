# Copié en deploy/prod.env par installer-serveur.sh (fichier ignoré par git, ne jamais le publier).

# Nom de domaine du site, sans https:// (ex. eduquest-famille.fr). Son DNS doit pointer vers ce serveur.
DOMAIN=

# Base de données : le mot de passe est tiré au hasard par le script d'installation.
POSTGRES_DB=eduquest
POSTGRES_USER=eduquest
POSTGRES_PASSWORD=

# Envoi des e-mails (validation des comptes parents, mot de passe oublié). Ex. Brevo :
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  identifiant et clé SMTP fournis par Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# L'adresse d'expédition doit être validée chez le prestataire e-mail.
MAIL_FROM="EduQuest CM1 <no-reply@exemple.fr>"
