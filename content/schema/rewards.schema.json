{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduquest.local/schema/rewards.schema.json",
  "title": "Catalogue de badges et accessoires",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rewards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rewards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "type", "title", "description", "assetKey", "ruleType", "ruleCode", "ruleParameters"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z_]+$" },
          "type": { "enum": ["BADGE", "COSMETIC"] },
          "slot": { "enum": ["HEAD", "BACK", "COMPANION"] },
          "title": { "type": "string", "maxLength": 60 },
          "description": { "type": "string", "maxLength": 200 },
          "assetKey": { "type": "string" },
          "ruleType": { "enum": ["FIRST_STAR", "FIRST_THREE_STARS", "WORLD_COMPLETED", "LEVEL_COMPLETED", "RANK_REACHED"] },
          "ruleCode": { "type": "string" },
          "ruleParameters": { "type": "object" }
        },
        "if": { "properties": { "type": { "const": "COSMETIC" } } },
        "then": { "required": ["slot"] },
        "else": { "not": { "required": ["slot"] } }
      }
    }
  }
}
