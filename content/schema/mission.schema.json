{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduquest.local/schema/mission.schema.json",
  "title": "Mission EduQuest (5 exercices)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "code", "world", "level", "ordinal", "title", "exercises"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "code": { "type": "string", "pattern": "^[A-Z]+-[1-3]-[1-2]$" },
    "world": { "type": "string", "pattern": "^[a-z-]+$" },
    "level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "ordinal": { "type": "integer", "minimum": 1, "maximum": 2 },
    "title": { "type": "string", "minLength": 2, "maxLength": 80 },
    "exercises": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/exercise" } }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 400 },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "type", "difficulty", "instruction", "prompt", "answer", "hint", "explanation"],
      "properties": {
        "skill": { "type": "string", "pattern": "^(MATH|EN)_[A-Z_]+$" },
        "type": { "enum": ["MCQ", "NUMBER", "TEXT"] },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
        "instruction": { "$ref": "#/$defs/text" },
        "prompt": { "$ref": "#/$defs/text" },
        "unit": { "type": "string", "maxLength": 20 },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label"],
            "properties": { "id": { "type": "string", "pattern": "^[a-d]$" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }
          }
        },
        "answer": {
          "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false,
          "properties": {
            "optionId": { "type": "string", "pattern": "^[a-d]$" },
            "number": { "type": "string", "pattern": "^-?[0-9]+([.,][0-9]+)?$" },
            "accepted": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 60 } }
          }
        },
        "hint": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "MCQ" } } }, "then": { "required": ["options"], "properties": { "answer": { "required": ["optionId"] } } } },
        { "if": { "properties": { "type": { "const": "NUMBER" } } }, "then": { "not": { "required": ["options"] }, "properties": { "answer": { "required": ["number"] } } } },
        { "if": { "properties": { "type": { "const": "TEXT" } } }, "then": { "not": { "required": ["options"] }, "properties": { "answer": { "required": ["accepted"] } } } }
      ]
    }
  }
}
