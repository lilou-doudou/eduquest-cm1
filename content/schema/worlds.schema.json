{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eduquest.local/schema/worlds.schema.json",
  "title": "Mondes, niveaux et compétences",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worlds",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "worlds": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "title",
          "subjectCode",
          "displayOrder",
          "availability",
          "assetKey",
          "description"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "subjectCode": {
            "enum": [
              "MATHS",
              "ENGLISH",
              "GEOMETRY",
              "GEOGRAPHY",
              "SCIENCES",
              "PHYSICS"
            ]
          },
          "displayOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "availability": {
            "enum": [
              "PLAYABLE",
              "COMING_SOON"
            ]
          },
          "assetKey": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "levels": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ordinal",
                "title"
              ],
              "properties": {
                "ordinal": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "title": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          }
        },
        "if": {
          "properties": {
            "availability": {
              "const": "PLAYABLE"
            }
          }
        },
        "then": {
          "required": [
            "levels"
          ],
          "properties": {
            "levels": {
              "minItems": 3
            }
          }
        },
        "else": {
          "properties": {
            "levels": {
              "maxItems": 0
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "subjectCode",
          "label",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(MATH|EN)_[A-Z_]+$"
          },
          "subjectCode": {
            "enum": [
              "MATHS",
              "ENGLISH"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 60
          },
          "description": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
