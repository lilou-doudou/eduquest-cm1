# Copier en .env (ignoré par git). Ne jamais y mettre de secret réel partagé.
POSTGRES_DB=eduquest
POSTGRES_USER=eduquest
POSTGRES_PASSWORD=eduquest-dev-only
DATABASE_URL=jdbc:postgresql://localhost:5432/eduquest
APP_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="EduQuest CM1 <no-reply@eduquest.local>"
SPRING_PROFILES_ACTIVE=dev

# Ports utilisés sur ton ordinateur (à changer si l'un est déjà pris, par ex. un PostgreSQL local).
# Si tu changes POSTGRES_HOST_PORT et utilises le mode développement (make dev), mets le même port dans DATABASE_URL.
POSTGRES_HOST_PORT=5432
MAILPIT_UI_PORT=8025
SMTP_HOST_PORT=1025
APP_PORT=3000
